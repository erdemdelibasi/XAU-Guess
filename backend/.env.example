# Copy to backend/.env and fill in. Values must match the GitHub Secrets of
# the same name, since the same code runs both locally and in Actions.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Optional. Without it the `claude` component stays permanently neutral
# (confidence 0) instead of crashing -- see claude_signal.py.
ANTHROPIC_API_KEY=sk-ant-...

# Optional, for the daily digest (backend/daily_report.py, 06:00 UTC on
# weekdays). GMAIL_APP_PASSWORD is a Google App Password, NOT the account
# password. Without GMAIL_ADDRESS the script prints the report and exits 0,
# so it doubles as a local preview: `cd backend && python daily_report.py`.
#
# These three used to sit here with no code behind them at all -- copied over
# from XRP-Guess in the first commit, advertising a feature this project had
# never implemented. They were removed on 2026-09-08 for that reason and are
# back now that daily_report.py exists. The names match XRP-Guess's so one
# App Password serves both repos.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
REPORT_RECIPIENT=you@gmail.com
